{
  "name": "bizuteca-9mm",
  "productName": "BIZUTECA 9MM",
  "version": "1.2.0",
  "description": "Caderno portátil de resumos, anotações e bizus com consulta offline ao seu material",
  "author": "Wesley",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win portable --x64",
    "pack": "electron-builder --win --dir --x64",
    "test:e2e": "node test/e2e.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "br.wesley.bizuteca9mm",
    "productName": "BIZUTECA 9MM",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "src/assets/bizuteca.ico"
    },
    "portable": {
      "artifactName": "BIZUTECA-9MM-Portatil.exe",
      "requestExecutionLevel": "user"
    }
  }
}
